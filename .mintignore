# Mintlify automatically ignores these files and directories:
# .git, .github, .claude, .agents, .idea, node_modules,
# README.md, LICENSE.md, CHANGELOG.md, CONTRIBUTING.md

# Draft content
drafts/
*.draft.mdx

# Markdown source files are converted into MDX by npm run docs:sync.
assets/**/*.md
assets/README.md
scripts/
package.json
package-lock.json
content-map.json
AGENTS.md
skills-lock.json
.codex/
preview*.png
test-results/
.cache/
